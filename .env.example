APP_NAME=CloudFile
DATABASE_URL=sqlite:///./cloudfile.db
DATABASE_DRIVER=sqlite
DATABASE_DSN=cloudfile-go.db
HTTP_ADDR=:8000
OBJECT_STORAGE_ROOT=./object_storage
OBJECT_STORAGE_BUCKET=cloudfile
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./object_storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cloudfile
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_DRIVER=inline
QUEUE_MODE=inline
MEDIA_PROCESSOR=copy
MAX_MEDIA_RETRY=3
MERGE_LOCK_TTL_SECONDS=120
PROCESSING_TIMEOUT_SECONDS=600
FFMPEG_TIMEOUT_SECONDS=300
